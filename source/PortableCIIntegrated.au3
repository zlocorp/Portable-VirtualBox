#include-once
#include "PortableCIVM.au3"
#include "PortableCommand.au3"

; Research-only orchestration inside the COMPILED AutoIt executable.
; These independently audited PowerShell effect adapters run only on a
; disposable, already elevated GitHub-hosted runner. Environment variables
; are anti-accident guards, NEVER a production privilege or trust boundary.
; No normal user entrypoint may invoke this function.
Func _PCI_Allowed($actions, $runner, $os, $repo, $root, $temp, $workspace)
    If Not _PVS_Allowed($actions, $runner, $os, $repo, $root, $temp) Then Return False
    If Not _PP_RootSafe($workspace) Or StringLen($workspace) <= 3 Then Return False
    If StringLower($workspace) == StringLower($root) Then Return False
    Return True
EndFunc

; No shell, substitutions, wildcard paths or user-supplied command arguments.
; Every path is constructed from a verified CI working root / runner temp.
Func _PCI_QuotePath($path)
    If Not _PP_RootSafe($path) Or StringLen($path) <= 3 Then Return ""
    Return Chr(34) & $path & Chr(34)
EndFunc

Func _PCI_RunScript($pwsh, $script, $args, $workspace, $phase)
    Local $quoted = _PCI_QuotePath($script)
    If $quoted == "" Then Return False
    Local $result = _PXR_Run($pwsh, "-NoLogo -NoProfile -NonInteractive -File " & $quoted & " " & $args, $workspace, 120000)
    ConsoleWrite("Native integrated " & $phase & ": " & $result["status"] & "/" & $result["exit_code"] & @CRLF)
    If $result["status"] <> "EXITED" Or $result["exit_code"] <> 0 Then
        ; A timed out, failed or unknown effect NEVER authorizes the next step
        ; or any speculative cleanup. The disposable host is discarded.
        Local $detail = StringLeft($result["error_output"], 500)
        If $detail <> "" Then ConsoleWriteError("Native integrated " & $phase & " stderr: " & $detail & @CRLF)
        Return False
    EndIf
    Return True
EndFunc

Func _PCI_Execute($root)
    Local $temp = EnvGet("RUNNER_TEMP"), $workspace = EnvGet("GITHUB_WORKSPACE")
    If Not _PCI_Allowed(EnvGet("GITHUB_ACTIONS"), EnvGet("RUNNER_ENVIRONMENT"), _
            EnvGet("RUNNER_OS"), EnvGet("GITHUB_REPOSITORY"), $root, $temp, $workspace) Then Return 9
    If Not _PP_ParentsSafe($root) Or Not _PP_ParentsSafe($workspace) Then Return 9

    Local $scripts = $workspace & "\scripts"
    Local $stageScript = $scripts & "\vbox_sup_standalone.ps1"
    Local $startScript = $scripts & "\vbox_sup_start_owned.ps1"
    Local $verifyScript = $scripts & "\check_native_vm_boot.ps1"
    Local $cleanScript = $scripts & "\vbox_sup_cleanup.ps1"
    Local $pwsh = @ProgramFilesDir & "\PowerShell\7\pwsh.exe"
    If Not FileExists($pwsh) Or Not FileExists($stageScript) Or _
            Not FileExists($startScript) Or Not FileExists($verifyScript) Or _
            Not FileExists($cleanScript) Then Return 9

    Local $stage = $temp & "\native-vm-sup-stage"
    Local $start = $temp & "\native-vm-sup-start"
    Local $verify = $temp & "\native-vm-independent-receipt"
    Local $clean = $temp & "\native-vm-cleanup"
    Local $transcript = $temp & "\native-vm-autogenerated-receipt.txt"
    ; All output locations must be new. Never overwrite or resume stale
    ; creation receipts; disk content is not a recoverable ownership ticket.
    If FileExists($stage) Or FileExists($start) Or FileExists($verify) Or _
            FileExists($clean) Or FileExists($transcript) Then Return 9
    Local $paths[5] = [$stage, $start, $verify, $clean, $transcript]
    For $i = 0 To UBound($paths) - 1
        If _PCI_QuotePath($paths[$i]) == "" Then Return 9
    Next

    Local $profile = _PP_Ensure($root)
    If $profile["status"] <> "READY" Or Not $profile["app_present"] Then Return 3
    Local $app = $profile["app"]
    ; A clean initial service/process baseline is a necessary condition.
    ; Actual exclusive driver creation is proved separately by the adapters.
    Local $installed = _PortableInstalledVBoxDetected()
    If @error Or Not IsBool($installed) Or $installed Then Return 4
    If _PortableCountExistingServices() <> 0 Or _PortableCountVirtualBoxProcesses() <> 0 Then Return 4

    Local $qApp = _PCI_QuotePath($app), $qStage = _PCI_QuotePath($stage)
    Local $qStart = _PCI_QuotePath($start), $qVerify = _PCI_QuotePath($verify)
    Local $qClean = _PCI_QuotePath($clean), $qRoot = _PCI_QuotePath($root)
    Local $stageReport = $stage & "\sup-standalone.json"
    Local $startReport = $start & "\sup-start-results.json"
    Local $verifyReport = $verify & "\vm-boot-results.json"
    If _PCI_QuotePath($stageReport) == "" Or _PCI_QuotePath($startReport) == "" Or _
            _PCI_QuotePath($verifyReport) == "" Then Return 9

    ConsoleWrite("Native integrated: BEGIN_DISPOSABLE_EXCLUSIVE_SESSION" & @CRLF)
    If Not _PCI_RunScript($pwsh, $stageScript, _
            "-AppDir " & $qApp & " -OutputDirectory " & $qStage & " -TimeoutSeconds 75", $workspace, "stage") Then Return 5
    If Not FileExists($stageReport) Then Return 5

    ; Start adapter checks exact acquisition receipt, hashes and service identity.
    If Not _PCI_RunScript($pwsh, $startScript, _
            "-StandaloneReport " & _PCI_QuotePath($stageReport) & _
            " -OutputDirectory " & $qStart & " -TimeoutSeconds 30", $workspace, "driver-start") Then Return 6
    If Not FileExists($startReport) Then Return 6
    Local $sup = _WinObsService("VBoxSup")
    If Not _PCVM_ExpectedSup($sup) Or _PortableCountExistingServices() <> 1 Or _
            _PortableCountVirtualBoxProcesses() <> 0 Then Return 6

    ; The actual Oracle VM creation, boot and poweroff happen in AutoIt.
    Local $vm = _PCVM_Execute($root, $transcript)
    If $vm <> 0 Then
        ConsoleWriteError("Native integrated: native VM returned " & $vm & "; cleanup not authorized." & @CRLF)
        Return 7
    EndIf
    If Not FileExists($transcript) Then Return 7

    ; Independent live host proof, not trusting the AutoIt marker alone.
    If Not _PCI_RunScript($pwsh, $verifyScript, _
            "-PortableRoot " & $qRoot & _
            " -Transcript " & _PCI_QuotePath($transcript) & _
            " -OutputDirectory " & $qVerify & " -TimeoutSeconds 30", $workspace, "verify") Then Return 8
    If Not FileExists($verifyReport) Then Return 8

    ; Exact-owned cleanup requires the entire receipt chain and fresh host checks.
    If Not _PCI_RunScript($pwsh, $cleanScript, _
            "-AppDir " & $qApp & _
            " -StandaloneReport " & _PCI_QuotePath($stageReport) & _
            " -DriverStartReport " & _PCI_QuotePath($startReport) & _
            " -BootReport " & _PCI_QuotePath($verifyReport) & _
            " -OutputDirectory " & $qClean & " -TimeoutSeconds 45", $workspace, "cleanup") Then Return 10

    If _PortableCountExistingServices() <> 0 Or _PortableCountVirtualBoxProcesses() <> 0 Then Return 11
    Local $vmFile = $profile["machines"] & "\pvbox_compiled_native_fixture\pvbox_compiled_native_fixture.vbox"
    If Not FileExists($vmFile) Or Not FileExists($profile["profile"] & "\VirtualBox.xml") Then Return 11
    ConsoleWrite("Native integrated: CLEAN; native VM and user data preserved" & @CRLF)
    Return 0
EndFunc
